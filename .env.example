# ─────────────────────────────────────────
#  OP Job Hunt — .env
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to git.
# ─────────────────────────────────────────

# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# GitHub (for README fetching)
GITHUB_TOKEN=

# CAPTCHA Solving (free tier)
TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

# App
SECRET_KEY=change_me_to_a_random_secret
DATABASE_URL=sqlite:////app/swarm.db
OUTPUT_DIR=/app/output

# Billing (Stripe). Test keys are fine for local dev.
#   STRIPE_SECRET_KEY   -- Dashboard > Developers > API keys (sk_...)
#   STRIPE_PRICE_ID     -- the recurring $15/mo Price you created (price_...)
#   STRIPE_WEBHOOK_SECRET -- shown when you add the /webhooks/stripe endpoint (whsec_...)
# Leave unset to run free-tier-only: upgrades report as unavailable, nothing 500s.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Lifetime free resume generations per account.
FREE_RESUME_LIMIT=30
# Comma-separated emails that bypass the quota entirely (your own accounts).
BILLING_UNLIMITED_EMAILS=
