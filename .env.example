# ─────────────────────────────────────────
#  OP Job Hunt — .env
#  Copy this to .env and fill in your keys.
#  NEVER commit .env to git.
# ─────────────────────────────────────────

# LLM Providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# GitHub (for README fetching)
GITHUB_TOKEN=

# CAPTCHA Solving (free tier)
TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

# App
SECRET_KEY=change_me_to_a_random_secret
DATABASE_URL=sqlite:////app/swarm.db
OUTPUT_DIR=/app/output

# Billing (Stripe). Test keys are fine for local dev.
#   STRIPE_SECRET_KEY   -- Dashboard > Developers > API keys (sk_...)
#   STRIPE_PRICE_ID     -- the recurring $15/mo Price you created (price_...)
#   STRIPE_WEBHOOK_SECRET -- shown when you add the /webhooks/stripe endpoint (whsec_...)
# Leave unset to run free-tier-only: upgrades report as unavailable, nothing 500s.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Lifetime free resume generations per account. Superseded by the token budget
# below -- kept only so the historical counter still renders.
FREE_RESUME_LIMIT=30
# Comma-separated emails that bypass the quota entirely (your own accounts).
BILLING_UNLIMITED_EMAILS=

# ─────────────────────────────────────────
#  Free tier (platform key)
# ─────────────────────────────────────────
# Users with no API key of their own run on the platform's key, metered against
# these lifetime budgets. Sized at roughly 20 tailored resumes end to end.
# Input and output are separate because output costs ~8x more per token.
FREE_INPUT_TOKENS=400000
FREE_OUTPUT_TOKENS=150000

# Bootstrap key for the free tier. Once you set a key in the admin panel, the
# saved value wins over these. Only the provider selected in the admin panel is
# ever loaded for a free user.
PLATFORM_GEMINI_API_KEY=
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_OPENAI_API_KEY=
PLATFORM_OPENROUTER_API_KEY=

# Comma-separated emails that can reach /api/admin/* and see the Admin nav item.
ADMIN_EMAILS=

# Rotating file logs (loguru). Defaults to ./logs at INFO.
LOG_DIR=./logs
LOG_LEVEL=INFO
